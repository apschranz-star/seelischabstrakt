{
  "name": "seelischabstrakt-store",
  "private": true,
  "type": "module",
  "description": "Storefront of seelischabstrakt: React 19 + Astryx. Built output is committed to the repository root (index.html, app/).",
  "scripts": {
    "dev": "vite",
    "theme": "astryx theme build src/theme/seelischTheme.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run theme && npm run typecheck && node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "astryx": "astryx"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.15",
    "@astryxdesign/theme-neutral": "0.7.15",
    "@stylexjs/stylex": "0.19.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.15",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
