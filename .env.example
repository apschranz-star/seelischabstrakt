# JING — environment template. Copy to .env.local and fill in.
# No secret belongs in the repository.

# Public base URL, used for canonical tags and Open Graph
NEXT_PUBLIC_SITE_URL="https://jing.example"

# Mock payment engine. Replace with a real PSP key before going live.
# The checkout route in app/api/checkout/route.ts creates sessions locally
# and never calls an external provider while this is unset.
PAYMENT_PROVIDER_KEY=""
